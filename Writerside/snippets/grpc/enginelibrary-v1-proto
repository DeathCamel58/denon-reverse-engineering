  map<uint32, QuickCue> map_field_4_UNCONFIRMED = 4;
  map<uint32, Loop>     map_field_5_UNCONFIRMED = 5;

  MainCue main_cue_UNCONFIRMED = 6;   // message
  bytes   field7_UNKNOWN       = 7;   // bytes (no UTF-8 verification)
  int64   field8_UNKNOWN       = 8;   // varint, sign-extended -> signed
  double  field9_UNKNOWN       = 9;   // fixed64
  bytes   field10_UNKNOWN      = 10;  // bytes (no UTF-8 verification)
}

