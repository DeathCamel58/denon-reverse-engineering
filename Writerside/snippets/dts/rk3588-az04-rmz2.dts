		pinctrl-0 = <0xfe>;
		pinctrl-names = "default";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x1f2>;

		ili2117@26 {
			compatible = "ilitek,ili2117";
			status = "okay";
			reg = <0x26 0x62>;
			reg-names = "default", "upgrade";
			pinctrl-names = "default";
			pinctrl-0 = <0xff 0x100>;
			interrupt-parent = <0x83>;
			interrupts = <0x11 0x02>;
			panel = <0x101>;
			reset-gpios = <0x83 0x10 0x01>;
		};
	};

	spi@fecb0000 {
		compatible = "rockchip,rk3588-spi", "rockchip,rk3066-spi";
		reg = <0x00 0xfecb0000 0x00 0x1000>;
		interrupts = <0x00 0x14a 0x04 0x00>;
		clocks = <0x21 0x9b 0x21 0x96>;
		clock-names = "spiclk", "apb_pclk";
		dmas = <0x74 0x0d 0x74 0x0e>;
		dma-names = "tx", "rx";
		num-cs = <0x02>;
		pinctrl-0 = <0x102 0x103 0x104>;
		pinctrl-names = "default";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "disabled";
		phandle = <0x1f3>;
	};

	efuse@fecc0000 {
		compatible = "rockchip,rk3588-otp";
		reg = <0x00 0xfecc0000 0x00 0x400>;
		clocks = <0x21 0x8c 0x21 0x8b 0x21 0x8f 0x21 0x8d>;
		clock-names = "otp", "apb_pclk", "phy", "arb";
		resets = <0x21 0xa7 0x21 0xa6 0x21 0xa8>;
		reset-names = "otp", "apb", "arb";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		bootph-some-ram;
		bootph-pre-ram;
		phandle = <0x1f4>;

		cpu-code@2 {
			reg = <0x02 0x02>;
			phandle = <0x1f5>;
		};

		id@7 {
			reg = <0x07 0x10>;
			phandle = <0x1f6>;
		};

		cpu-leakage@17 {
			reg = <0x17 0x01>;
			phandle = <0x1f7>;
		};

		cpu-leakage@18 {
			reg = <0x18 0x01>;
			phandle = <0x1f8>;
		};

		cpu-leakage@19 {
			reg = <0x19 0x01>;
			phandle = <0x1f9>;
		};

		log-leakage@1a {
			reg = <0x1a 0x01>;
			phandle = <0x1fa>;
		};

		gpu-leakage@1b {
			reg = <0x1b 0x01>;
			phandle = <0x1fb>;
		};

		cpu-version@1c {
			reg = <0x1c 0x01>;
			bits = <0x03 0x03>;
