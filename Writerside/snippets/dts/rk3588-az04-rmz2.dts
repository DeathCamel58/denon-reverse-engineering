			fit,align = <0x200>;
			phandle = <0x16e>;

			images {

				u-boot {
					description = "U-Boot";
					type = "standalone";
					os = "u-boot";
					arch = "arm64";
					compression = "none";
					load = <0x800000>;
					entry = <0x800000>;

					u-boot-nodtb {
						compress = "none";
					};

					hash {
						algo = "sha256";
					};
				};

				@atf-SEQ {
					fit,operation = "split-elf";
					description = "ARM Trusted Firmware";
					type = "firmware";
					arch = "arm64";
					os = "arm-trusted-firmware";
					compression = "none";
					fit,load;
					fit,entry;
					fit,data;

					atf-bl31 {
					};

					hash {
						algo = "sha256";
					};
				};

				@tee-SEQ {
					fit,operation = "split-elf";
					description = "TEE";
					type = "tee";
					arch = "arm64";
					os = "tee";
					compression = "none";
					fit,load;
					fit,entry;
					fit,data;

					tee-os {
						optional;
					};

					hash {
						algo = "sha256";
					};
				};

				@fdt-SEQ {
					description = "fdt-NAME";
					compression = "none";
					type = "flat_dt";

					hash {
						algo = "sha256";
					};
				};
			};

			configurations {
				default = "@config-DEFAULT-SEQ";

				@config-SEQ {
					description = "NAME.dtb";
					fdt = "fdt-SEQ";
					fit,firmware = "atf-1", "u-boot";
					fit,loadables;
					fit,compatible;

					signature-1 {
						algo = "sha256,rsa2048";
						key-name-hint = "stage2-rane-1";
						sign-images = "fdt", "firmware", "loadables";
					};
				};
			};
		};

		simple-bin {
			filename = "u-boot-rockchip.bin";
			pad-byte = <0xff>;

			mkimage {
				filename = "idbloader.img";
				args = "-n", "rk3588", "-T", "rksd";
				multiple-data-files;

				rockchip-tpl {
				};

				spl {
					type = "section";

					u-boot-spl-nodtb {
					};

					u-boot-spl-pubkey-dtb {
						algo = "sha256,rsa2048";
						align = <0x08>;
						required = "conf";
						key-name-hint = "stage2-rane-1";
					};
				};
			};

			fit {
				filename = "u-boot.itb";
				insert-template = <0x16e>;
				offset = <0x7f8000>;
			};
		};
	};

	dmc {
		compatible = "rockchip,rk3588-dmc";
		bootph-all;
	};

	bootcount@200 {
		compatible = "u-boot,bootcount-syscon";
		syscon = <0x86>;
		reg = <0x00 0x200 0x00 0x04 0x00 0x00 0x00 0x04>;
		reg-names = "syscon_reg", "offset";
		phandle = <0x225>;
	};

	signature {

		key-rane-1 {
			required = "conf";
			algo = "sha256,rsa2048";
			rsa,r-squared = <0x47bbb85e 0x79b9727d 0xbe42cdd0 0xd395527b 0xec0f9384 0x2b8f241 0xf4a518bb 0x15feb8a4 0x6cf905ae 0x3eadd4d6 0xfb189589 0xf273da3c 0x5072c44f 0x4155278a 0x97244451 0xd6ef78ae 0xc825948e 0x48154047 0x3adcba23 0xd5327a02 0x45cb1c39 0x76fad7f1 0x272f6424 0x30136697 0x263370c7 0xc7c984f9 0xe3f58d59 0xc0333a18 0xc5a8637e 0x29e624cf 0x670e6733 0x857de522 0x9154a9ae 0x569e311c 0x1f12e08f 0x80498ef5 0x960697d5 0x889a671a 0xac7bf889 0x4e3f3a02 0x608f9a12 0xefe68e49 0xeb9206ba 0x713f1cf2 0xabefa946 0xe9a625d6 0xcb69dc7 0x4cb4f78d 0x24ae2630 0x7e983932 0x8bf7e32e 0x8f2923e5 0xd5eb2314 0x573ec6f 0x1a1b35cf 0x81cee773 0xb13b4ab3 0xe8aa1a7b 0x8e66a20d 0xe98b2664 0x935f0039 0x825dd606 0x6024b7b6 0xd3f8356>;
			rsa,modulus = <0xa19e37a5 0x2b3e9d7a 0xf7f614da 0xd7d1dfd3 0xd7102c47 0xf428909 0xab06af89 0x8c083a57 0xbead48d9 0x8701a9cf 0x2856975b 0xad01d2f7 0x6c48bd2a 0x5e6b5926 0xf7d5af8f 0x2d79aef6 0xc790d89 0x749292fb 0x2f924834 0x4531ecdd 0xb003635b 0xa8f8f079 0x8c8e8b17 0xe40dd4bf 0x4db610c3 0x9bf60201 0x94883e6a 0xdf75e40a 0xee7c99f6 0x15a6d606 0x6cb47ded 0xea43db75 0xfcdba235 0x2cb27500 0x5b9ce529 0xb3296f93 0x70be4e37 0xeef55bc5 0x71975892 0xe9fcbcd3 0xe10980fd 0xfcee2a65 0xa334928c 0x66cea5a4 0xd59de393 0xd22a64c7 0x6d56782 0xf3fbb6 0x54f6d058 0x5ba08cf5 0x3aaa6c00 0x8d00ce73 0xdc0d252 0x707d71d3 0x8fc3ae48 0xfadba7de 0xce6723b7 0x1fc633e7 0x7f2a8c57 0x6941b0c 0xb532eb34 0xf189c26e 0x574fca67 0x49e42f3f>;
			rsa,exponent = <0x00 0x10001>;
			rsa,n0-inverse = <0x5e30bf41>;
